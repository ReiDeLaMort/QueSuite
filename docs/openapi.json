{
  "openapi": "3.1.0",
  "info": {
    "title": "QueSuite CMMS pilot API",
    "version": "0.1.0",
    "description": "Online owner-led pilot. Hosted routes require private platform access; application memberships are not implemented. Local development has no login and must remain local. Organization and actor are server-selected. Keep stable operation IDs and asset UUIDs on retries. Whitespace is trimmed and asset tags uppercase. A 409 returns an error; GET /api/snapshot retrieves current records."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/snapshot": {
      "get": {
        "operationId": "getSnapshot",
        "responses": {
          "200": {
            "description": "Success or original accepted result replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/assets": {
      "post": {
        "operationId": "createAsset",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetCreate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or original accepted result replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Asset"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin write rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Work order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version, operation ID, asset tag, or reference conflict. Refresh the snapshot and review local intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 16000 characters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Field or lifecycle validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/work-orders": {
      "post": {
        "operationId": "applyWorkOrderCommand",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkOrderCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success or original accepted result replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkOrder"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin write rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Work order not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Version, operation ID, asset tag, or reference conflict. Refresh the snapshot and review local intent.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds 16000 characters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Use application/json",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Field or lifecycle validation failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Create at requested/version 1. Transitions accept only the next lifecycle status and expectedVersion. Assignment requires assignee; completion requires completionNote. Mutation, audit entry, and result commit atomically. Closed work orders are immutable. Unknown fields cannot change server ownership or actor."
      }
    }
  },
  "components": {
    "schemas": {
      "AssetCreate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": ["id", "tag", "name", "location"]
      },
      "Asset": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string"
          },
          "tag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "tag",
          "name",
          "location",
          "createdAt"
        ]
      },
      "WorkOrder": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "assetTag": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "serviceLocation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "urgent"]
          },
          "type": {
            "type": "string",
            "enum": ["corrective", "preventive", "inspection"]
          },
          "status": {
            "type": "string",
            "enum": [
              "requested",
              "assigned",
              "in_progress",
              "completed",
              "closed"
            ]
          },
          "assignee": {
            "type": ["string", "null"]
          },
          "completionNote": {
            "type": ["string", "null"]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "assetId",
          "assetTag",
          "serviceLocation",
          "title",
          "description",
          "priority",
          "type",
          "status",
          "assignee",
          "completionNote",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "Snapshot": {
        "type": "object",
        "properties": {
          "assets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Asset"
            }
          },
          "workOrders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkOrder"
            }
          }
        },
        "required": ["assets", "workOrders"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "CreateWorkOrder": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "create"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "assetId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000,
            "default": ""
          },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "urgent"]
          },
          "type": {
            "type": "string",
            "enum": ["corrective", "preventive", "inspection"]
          }
        },
        "required": [
          "kind",
          "operationId",
          "id",
          "assetId",
          "title",
          "priority",
          "type"
        ]
      },
      "TransitionWorkOrder": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "transition"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["assigned", "in_progress", "completed", "closed"]
          },
          "assignee": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "completionNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": ["kind", "operationId", "id", "expectedVersion", "status"]
      },
      "WorkOrderCommand": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/CreateWorkOrder"
          },
          {
            "$ref": "#/components/schemas/TransitionWorkOrder"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "create": "#/components/schemas/CreateWorkOrder",
            "transition": "#/components/schemas/TransitionWorkOrder"
          }
        }
      }
    }
  }
}
